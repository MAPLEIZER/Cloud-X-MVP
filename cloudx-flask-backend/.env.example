# Clerk backend authentication. Never commit the real secret key.
CLERK_SECRET_KEY=sk_test_replace_me

# Comma-separated frontend origins. No paths.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Comma-separated Clerk user IDs permitted to operate Cloud-X.
CLERK_ALLOWED_USER_IDS=user_replace_me

# Optional: networkless Clerk JWT verification key (PEM).
# CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----...

# Fail-closed remote deployment authorization. Keys are Clerk principals and
# values are exact host/IP entries or CIDRs. CIDRs authorize literal IP targets
# only; hostnames must be explicitly listed.
DEPLOYMENT_TARGET_ALLOWLIST_JSON={"user:user_replace_me":["192.168.1.0/24","server.example.com"],"org:org_replace_me":["10.0.0.10"]}

# The WinRM installer path is security-sensitive and remains disabled unless an
# operator explicitly enables it after validating WinRM in their environment.
ENABLE_WINDOWS_AGENT_DEPLOYMENT=false

# PostgreSQL. Use a strong password and URL-encode special characters in
# DATABASE_URL when necessary.
POSTGRES_DB=cloudx
POSTGRES_USER=cloudx
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql+psycopg://cloudx:replace_with_a_long_random_password@postgres:5432/cloudx

# Redis/RQ durable scan queue. The Compose default is internal-only Redis with
# AOF persistence; use an authenticated/TLS Redis endpoint for external service.
REDIS_URL=redis://redis:6379/0
MAX_CONCURRENT_SCANS=4
SCAN_WORKERS=2

# Scan work is isolated in RQ workers, so the API can run multiple Gunicorn
# workers without losing scan process state during API restarts.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300

# Wazuh server API (Manager) — agent inventory, SCA and FIM.
WAZUH_API_URL=https://wazuh-manager.example.com:55000
WAZUH_API_USERNAME=cloudx-api
WAZUH_API_PASSWORD=replace_with_a_long_random_password
WAZUH_API_VERIFY_TLS=true
# WAZUH_API_CA_BUNDLE=/run/secrets/wazuh-manager-ca.crt

# Wazuh Indexer API — alert documents from wazuh-alerts*.
WAZUH_INDEXER_URL=https://wazuh-indexer.example.com:9200
WAZUH_INDEXER_USERNAME=cloudx-indexer
WAZUH_INDEXER_PASSWORD=replace_with_a_long_random_password
WAZUH_INDEXER_VERIFY_TLS=true
# WAZUH_INDEXER_CA_BUNDLE=/run/secrets/wazuh-indexer-ca.crt

WAZUH_REQUEST_TIMEOUT_SECONDS=10
WAZUH_CACHE_TTL_SECONDS=15
