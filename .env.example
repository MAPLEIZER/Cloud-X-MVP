# Cloud-X cross-stack configuration reference.
# Copy only the variables needed by the component you are running. Never commit
# a populated .env file.

# Frontend build-time configuration
VITE_API_BASE_URL=http://localhost:5001
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Backend Clerk authentication
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
CLERK_ALLOWED_USER_IDS=user_replace_me
# CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----...

# Remote agent deployment authorization
DEPLOYMENT_TARGET_ALLOWLIST_JSON={"user:user_replace_me":["192.168.1.0/24","server.example.com"],"org:org_replace_me":["10.0.0.10"]}
ENABLE_WINDOWS_AGENT_DEPLOYMENT=false

# PostgreSQL
POSTGRES_DB=cloudx
POSTGRES_USER=cloudx
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql+psycopg://cloudx:replace_with_a_long_random_password@postgres:5432/cloudx

# Backend runtime
MAX_CONCURRENT_SCANS=4
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=300

# Wazuh server API connector configuration (consumed by Phase 1 issue #24).
# Wazuh's API normally uses HTTPS and JWT authentication obtained from API
# username/password credentials. Keep TLS verification enabled in supported
# deployments and provide a trusted CA when the Manager uses a private CA.
WAZUH_API_URL=https://wazuh-manager.example.com:55000
WAZUH_API_USERNAME=cloudx-api
WAZUH_API_PASSWORD=replace_with_a_long_random_password
WAZUH_API_VERIFY_TLS=true
# WAZUH_API_CA_BUNDLE=/run/secrets/wazuh-ca.crt
