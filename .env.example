# Cloud-X cross-stack configuration reference.
# Copy only the variables needed by the component you are running. Never commit
# a populated .env file.

# Frontend build-time configuration
VITE_API_BASE_URL=http://localhost:5001
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Backend Clerk authentication
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
CLERK_ALLOWED_USER_IDS=user_replace_me
# CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----...

# Remote agent deployment authorization
DEPLOYMENT_TARGET_ALLOWLIST_JSON={"user:user_replace_me":["192.168.1.0/24","server.example.com"],"org:org_replace_me":["10.0.0.10"]}
ENABLE_WINDOWS_AGENT_DEPLOYMENT=false

# PostgreSQL
POSTGRES_DB=cloudx
POSTGRES_USER=cloudx
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql+psycopg://cloudx:replace_with_a_long_random_password@postgres:5432/cloudx

# Durable scan queue. In the checked-in Compose stack Redis is internal-only and
# persists its append-only log to a named volume.
REDIS_URL=redis://redis:6379/0
MAX_CONCURRENT_SCANS=4
SCAN_WORKERS=2

# API runtime. Scan work no longer lives in Gunicorn processes, so the API can
# safely run multiple workers. Production request/application logs are emitted as
# one JSON object per line and include request IDs but not bodies/query strings.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300
LOG_LEVEL=INFO

# Wazuh server API (Manager) — agents, SCA and FIM.
# The adapter requires HTTPS. Keep TLS verification enabled and provide a trusted
# CA bundle if the Manager uses a private CA.
WAZUH_API_URL=https://wazuh-manager.example.com:55000
WAZUH_API_USERNAME=cloudx-api
WAZUH_API_PASSWORD=replace_with_a_long_random_password
WAZUH_API_VERIFY_TLS=true
# WAZUH_API_CA_BUNDLE=/run/secrets/wazuh-manager-ca.crt

# Wazuh Indexer API — alert documents from wazuh-alerts*.
WAZUH_INDEXER_URL=https://wazuh-indexer.example.com:9200
WAZUH_INDEXER_USERNAME=cloudx-indexer
WAZUH_INDEXER_PASSWORD=replace_with_a_long_random_password
WAZUH_INDEXER_VERIFY_TLS=true
# WAZUH_INDEXER_CA_BUNDLE=/run/secrets/wazuh-indexer-ca.crt

# Connector bounds/cache. Credentials/tokens are never returned to the frontend.
WAZUH_REQUEST_TIMEOUT_SECONDS=10
WAZUH_CACHE_TTL_SECONDS=15
