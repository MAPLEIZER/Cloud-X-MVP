# Build stage
FROM node:26-alpine AS build
WORKDIR /app

# Build-time API configuration remains a development/backward-compatible fallback.
# Supported appliance releases inject API + Clerk config at container startup.
ARG FRONTEND_API_BASE_URL=
ENV VITE_API_BASE_URL=${FRONTEND_API_BASE_URL}

RUN npm install --global pnpm@10.34.5 \
    && pnpm --version
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm build

# Runtime stage
FROM nginx:alpine
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY deploy/frontend/10-cloudx-runtime-config.sh /docker-entrypoint.d/10-cloudx-runtime-config.sh
COPY --from=build /app/dist /usr/share/nginx/html
RUN chmod 0555 /docker-entrypoint.d/10-cloudx-runtime-config.sh

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
