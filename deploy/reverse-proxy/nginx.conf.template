server {
    listen 80;
    server_name _;

    # Nginx process liveness only.
    location = /_proxy/health {
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # Cloud-X application probes. These deliberately bypass frontend routing and
    # preserve backend status codes so load balancers/orchestrators can distinguish
    # process liveness from dependency readiness.
    location = /_health/live {
        proxy_pass $BACKEND_UPSTREAM/api/health/live;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 10;
        proxy_send_timeout 10;
    }

    location = /_health/ready {
        proxy_pass $BACKEND_UPSTREAM/api/health/ready;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 10;
        proxy_send_timeout 10;
    }

    # API routes to backend.
    location /api/ {
        proxy_pass $BACKEND_UPSTREAM;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 300;
        proxy_send_timeout 300;
    }

    # Everything else to frontend (static assets / SPA).
    location / {
        proxy_pass $FRONTEND_UPSTREAM;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 120;
        proxy_send_timeout 120;
    }
}
