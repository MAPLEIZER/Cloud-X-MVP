# Copy to .env and replace every placeholder before deployment.
# The versioned appliance bundle pins container images by immutable digest.

POSTGRES_DB=cloudx
POSTGRES_USER=cloudx
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql+psycopg://cloudx:replace_with_a_long_random_password@postgres:5432/cloudx

REDIS_URL=redis://redis:6379/0
SCAN_WORKERS=2
MAX_CONCURRENT_SCANS=4

# Frontend runtime configuration. The release image is environment-neutral.
# Empty CLOUDX_API_BASE_URL means same-origin /api routing through the reverse proxy.
CLOUDX_API_BASE_URL=
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Backend Clerk session JWT verification.
# Literal \n escapes are accepted by the backend if a single-line value is easier to manage.
CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----
CLERK_AUTHORIZED_PARTIES=https://cloudx.example.com
CLERK_ALLOWED_USER_IDS=user_replace_me

DEPLOYMENT_TARGET_ALLOWLIST_JSON={"user:user_replace_me":["192.168.1.0/24"]}
ENABLE_WINDOWS_AGENT_DEPLOYMENT=false

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300
LOG_LEVEL=INFO

ERROR_TRACKING_DSN=
ERROR_TRACKING_ENVIRONMENT=production
ERROR_TRACKING_TRACES_SAMPLE_RATE=0.0
ERROR_TRACKING_INCLUDE_USER_ID=false

WAZUH_API_URL=https://wazuh-manager.example.com:55000
WAZUH_API_USERNAME=cloudx-api
WAZUH_API_PASSWORD=replace_with_a_long_random_password
WAZUH_API_VERIFY_TLS=true

WAZUH_INDEXER_URL=https://wazuh-indexer.example.com:9200
WAZUH_INDEXER_USERNAME=cloudx-indexer
WAZUH_INDEXER_PASSWORD=replace_with_a_long_random_password
WAZUH_INDEXER_VERIFY_TLS=true

WAZUH_REQUEST_TIMEOUT_SECONDS=10
WAZUH_CACHE_TTL_SECONDS=15

# Host paths to an existing certificate and private key.
CLOUDX_TLS_CERT_FILE=/etc/letsencrypt/live/cloudx.example.com/fullchain.pem
CLOUDX_TLS_KEY_FILE=/etc/letsencrypt/live/cloudx.example.com/privkey.pem
CLOUDX_HTTP_PORT=80
CLOUDX_HTTPS_PORT=443
