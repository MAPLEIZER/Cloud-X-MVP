server {
    listen 80;
    server_name ${CLOUDX_PUBLIC_HOSTNAME};
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ${CLOUDX_PUBLIC_HOSTNAME};

    ssl_certificate /etc/cloudx/tls/fullchain.pem;
    ssl_certificate_key /etc/cloudx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /_proxy/health {
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location = /_health/live {
        proxy_pass $BACKEND_UPSTREAM/api/health/live;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 10;
        proxy_send_timeout 10;
    }

    location = /_health/ready {
        proxy_pass $BACKEND_UPSTREAM/api/health/ready;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 10;
        proxy_send_timeout 10;
    }

    location /api/ {
        proxy_pass $BACKEND_UPSTREAM;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 300;
        proxy_send_timeout 300;
    }

    location / {
        proxy_pass $FRONTEND_UPSTREAM;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 120;
        proxy_send_timeout 120;
    }
}
