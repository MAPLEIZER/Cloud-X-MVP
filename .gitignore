# Dependencies
node_modules/

# Build output
dist/
build/

# Environment files (examples remain tracked)
.env
.env.*
!.env.example
!**/.env.example

# Virtual environments
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs and runtime state
logs/
*.log
*.pid
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# TanStack temp files
.tanstack/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Local databases / state
*.db
*.db-*
*.sqlite
*.sqlite3

# Private key / certificate containers. Public certificates may be tracked when
# intentionally required, but never private-key-bearing formats.
*.pfx
*.p12
*.key
*.pem
id_rsa
id_ed25519

# Local config
*.local
